    "test": "npm run test:signals && npm run test:usage && npm run test:queue && npm run test:emails && npm run test:emails-extra && npm run test:strategist && npm run test:recherche && npm run test:migrations && npm run test:qualite",
    "test:queue": "tsc -p tsconfig.test.json && node -r ./scripts/alias.cjs .test-build/scripts/queue.test.js",
    "test:charts": "tsc -p tsconfig.test.json && node -r ./scripts/alias.cjs .test-build/scripts/charts.test.js",
    "test:emails": "tsc -p tsconfig.test.json && node -r ./scripts/alias.cjs .test-build/scripts/emails.test.js",
