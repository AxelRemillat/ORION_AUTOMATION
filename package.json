    "test:strategist": "tsc -p tsconfig.test.json && node -r ./scripts/alias.cjs .test-build/scripts/strategist.test.js",
    "test:recherche": "tsc -p tsconfig.test.json && node -r ./scripts/alias.cjs .test-build/scripts/recherche.test.js",
    "check:migrations": "tsc -p tsconfig.test.json && node .test-build/scripts/check-migrations.js supabase/migrations",
    "test:migrations": "tsc -p tsconfig.test.json && node -r ./scripts/alias.cjs .test-build/scripts/check-migrations.test.js",
    "test:qualite": "tsc -p tsconfig.test.json && node -r ./scripts/alias.cjs .test-build/scripts/qualite.test.js"
