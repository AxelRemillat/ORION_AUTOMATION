# ---------------------------------------------------------------------------
# PROSPECT — copier ce fichier en `.env.local` et remplir les valeurs.
# `.env.local` est ignoré par git : ne jamais le committer.
# ---------------------------------------------------------------------------

# --- Supabase (Project Settings > API) -------------------------------------
# Exposées au navigateur (préfixe NEXT_PUBLIC_) : URL + clé anon.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role : SERVEUR UNIQUEMENT (bypass RLS). Jamais préfixée NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE=

# --- OpenAI (génération des messages de prospection) -----------------------
OPENAI_API_KEY=
# Optionnel : surcharge le modèle par défaut utilisé par lib/openai.ts
OPENAI_MODEL=gpt-4o-mini
# Optionnel : un modèle par rôle de la chaîne (lib/ai/models.ts).
# Vides = OPENAI_MODEL partout, c'est-à-dire le comportement historique.
# TODO(tarifs) : choisir sur developers.openai.com/api/docs/pricing un modèle
# de raisonnement fort (stratège), un moyen (rédacteur), le moins cher
# (extraction, juge), et reporter leurs prix dans OPENAI_PRICES_JSON.
OPENAI_MODEL_EXTRACT=
OPENAI_MODEL_STRATEGIST=
OPENAI_MODEL_WRITER=
OPENAI_MODEL_JUDGE=
# Effort d'un modèle de raisonnement : low | medium | high (défaut stratège : medium).
OPENAI_REASONING_EFFORT_STRATEGIST=
# Prix des modèles absents de la grille, en $ par million de tokens :
# OPENAI_PRICES_JSON={"nom-du-modele":{"input":0,"output":0}}
OPENAI_PRICES_JSON=

# --- Sources de données entreprises ----------------------------------------
# Pappers : données légales FR (SIREN, dirigeants, bilans)
PAPPERS_API_KEY=
# Linkup : recherche web / signaux d'actualité
LINKUP_API_KEY=
# Hunter : recherche et vérification d'emails professionnels
HUNTER_API_KEY=

# --- Prise de rendez-vous --------------------------------------------------
# Lien Google Agenda glissé dans le CTA des emails générés. Sans lui, le mail
# propose simplement de répondre — aucune URL n'est inventée.
NEXT_PUBLIC_BOOKING_URL=

# --- Tarification (page Coûts) — TOUTES OPTIONNELLES -----------------------
# Sans elles l'app compte quand même la consommation exacte ; seuls les
# montants en euros et l'estimation du "restant" sont indisponibles.
#
# Taux de conversion des services facturés en dollars (OpenAI, Linkup).
USD_EUR_RATE=0.92
# Prix public Linkup, surchargeable si votre plan diffère.
LINKUP_SEARCH_USD=0.005
# Valeur d'un crédit Pappers dans VOTRE forfait, en euros (0 = inconnu).
PAPPERS_CREDIT_EUR=
# Forfait Pappers, pour estimer le restant si /suivi-jetons ne répond pas.
PAPPERS_PLAN_CREDITS=500
# Valeur d'une recherche Hunter dans VOTRE forfait, en euros (0 = inconnu).
HUNTER_SEARCH_EUR=
# Budget mensuel OpenAI : OpenAI n'expose aucun solde, c'est le seul moyen
# d'estimer ce qu'il vous reste.
OPENAI_MONTHLY_BUDGET_EUR=

# --- Corbeille ---------------------------------------------------------------
# Secret des crons Vercel : /api/cron/purge-trash exige
# « Authorization: Bearer <CRON_SECRET> » (Vercel l'envoie tout seul).
# Générer avec : openssl rand -hex 32
CRON_SECRET=

# --- n8n (automatisation d'envoi des messages) -----------------------------
N8N_WEBHOOK_SEND_URL=

# Secret partage avec le workflow n8n de reception (docs/n8n-inbound.md).
# /api/inbound est un point d'ecriture PUBLIC : sans ce secret il est refuse.
# Generer avec : openssl rand -hex 32
INBOUND_WEBHOOK_SECRET=
